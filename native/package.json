{
  "name": "two-tap-hiit-native",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-tracking-transparency": "~57.0.2",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "oxlint": "^1.86.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "start:ja": "EXPO_PUBLIC_LOCALE=ja expo start",
    "android": "expo run:android",
    "android:ja": "EXPO_PUBLIC_LOCALE=ja expo run:android",
    "android:clean": "expo prebuild --clean --platform android && EXPO_PUBLIC_LOCALE=ja expo run:android",
    "ios": "expo run:ios",
    "ios:ja": "EXPO_PUBLIC_LOCALE=ja expo run:ios",
    "ios:clean": "expo prebuild --clean --platform ios && EXPO_PUBLIC_LOCALE=ja expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "generate:sounds": "node scripts/generate-sounds.mjs",
    "lint": "oxlint",
    "testflight": "npx testflight@latest",
    "testflight:test-ads": "npx eas-cli@latest build --platform ios --profile testflight-test-ads --auto-submit-with-profile production"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
